# CyberMail backend — local development environment variables
# All of these already have defaults in app/config/settings.py,
# so this file is optional right now — but explicit is better
# than implicit once you start changing any of these.

HOST=0.0.0.0
PORT=8000

# Optional scanners — safe to leave as-is if you don't have
# ClamAV/tesseract installed locally.
ENABLE_URLHAUS_API=true
ENABLE_CLAMAV=false
ENABLE_OCR=true

CLAMD_HOST=localhost
CLAMD_PORT=3310

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=15